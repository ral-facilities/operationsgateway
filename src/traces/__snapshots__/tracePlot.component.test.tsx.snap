exports[`Trace plot component > renders a div element with the correct attributes passed the correct props 1`] = `
<DocumentFragment>
  <div
    style="flex: 1 0 0px; max-height: calc(100vh - 38px); max-width: calc(100% - 150px);"
  >
    <div
      class="plotly-chart"
      data-config="{"scrollZoom":true,"displaylogo":false,"displayModeBar":false,"responsive":true,"showAxisDragHandles":false}"
      data-data="[{"type":"scatter","x":[1,2,3],"y":[5,6,4],"line":{"color":"#1F77B4","width":1.5},"mode":"lines"}]"
      data-layout="{"paper_bgcolor":"rgba(0, 0, 0, 0)","plot_bgcolor":"rgba(0, 0, 0, 0)","title":{"text":"scatter plot"},"margin":{"l":5,"r":5,"b":5,"t":35},"showlegend":false,"xaxis":{"type":"linear","exponentformat":"none","automargin":true,"range":[1,3],"maxallowed":3,"minallowed":1,"color":"#eee","gridcolor":"#eee","tickfont":{"color":"#444"}},"yaxis":{"type":"linear","exponentformat":"none","automargin":true,"range":[4,6],"maxallowed":6,"minallowed":4,"color":"#eee","gridcolor":"#eee","tickfont":{"color":"#444"}},"uirevision":"false","font":{"color":"#444"}}"
    />
  </div>
</DocumentFragment>
`;

