// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Image view component > renders an image and a canvas overlay 1`] = `
<DocumentFragment>
  <div
    style="position: relative;"
  >
    <div
      style="display: grid; overflow: hidden; scrollbar-gutter: stable; scrollbar-width: thin; height: min(-8px + 8px + 8px + 30px + 100vh, (0.666667) * calc(100vw - 8px + 8px + 8px + 8px + 150px + 300px), 200px); width: min(-8px + 8px + 8px + 8px + 150px + 300px + 100vw, (1.5) * calc(100vh - 8px + 8px + 8px + 30px), 300px);"
    >
      <img
        alt="Test image"
        src="testSrc"
        style="grid-area: 1 / 1; transform: translate(0px,0px) scale(1); transform-origin: top left; image-rendering: pixelated; max-height: calc(100vh - 8px + 8px + 8px + 30px); max-width: calc(100vw - 8px + 8px + 8px + 8px + 150px + 300px);"
      />
      <canvas
        data-testid="overlay"
        id="overlay"
        style="grid-area: 1 / 1; z-index: 2; pointer-events: none; image-rendering: pixelated; height: min(-8px + 8px + 8px + 30px + 100vh, (0.666667) * calc(100vw - 8px + 8px + 8px + 8px + 150px + 300px), 200px); width: min(-8px + 8px + 8px + 8px + 150px + 300px + 100vw, (1.5) * calc(100vh - 8px + 8px + 8px + 30px), 300px);"
      />
    </div>
  </div>
</DocumentFragment>
`;
